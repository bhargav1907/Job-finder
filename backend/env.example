# Copy to backend/.env and fill in. Never commit the real file.

# --- LLM provider (BytePlus Ark, Anthropic-compatible endpoint) ---
# Use a dedicated API key for this app. Do NOT reuse the Claude Code auth token.
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api

# Model tiers. Start small; escalate only when JSON quality breaks.
LLM_PARSE_MODEL=dola-seed-2.0-lite
LLM_RERANK_MODEL=dola-seed-2.0-lite
LLM_FALLBACK_MODEL=deepseek-v4.1-flash

# --- Storage ---
DATABASE_URL=sqlite:///./data/jobfinder.db

# --- Retrieval ---
# Local embedding model (fastembed). 384 dimensions.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=40
RERANK_BATCH_SIZE=10

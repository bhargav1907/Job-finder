# Copy to backend/.env. The defaults below target a local Ollama server,
# so this file works as-is once `ollama pull qwen3:4b` and
# `ollama pull lfm3:1.7b` have been run.

# --- LLM provider (local) ---
# Never point this at a coding-plan / harness endpoint. That credential is not
# licensed for application use.
LLM_PROTOCOL=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_PARSE_MODEL=qwen3:4b
LLM_RERANK_MODEL=lfm3:1.7b
LLM_FALLBACK_MODEL=llama3.2:3b
LLM_TIMEOUT=120
# Cap the context window so Ollama does not allocate more memory than needed.
LLM_NUM_CTX=8192

# --- Storage ---
DATABASE_URL=sqlite:///./data/jobfinder.db

# --- Resume upload ---
RESUME_MAX_BYTES=5242880
RESUME_MAX_CHARS=50000

# --- Retrieval ---
# Local embedding model (fastembed). 384 dimensions.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=40
RERANK_BATCH_SIZE=10
FINAL_TOP_K=30
UNSTATED_TARGET_SHARE=0.3333
RERANK_LLM_WEIGHT=0.7
